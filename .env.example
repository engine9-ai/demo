# Local development secrets. Copy to `.env` (gitignored).
# `astro dev` and `wrangler dev` both read `.env`.
# Do NOT keep a .dev.vars file — if present, Wrangler prefers it and ignores .env.
# In production, copy the same names with: npx wrangler secret put <NAME>
#

# Optional for Identity Tokens (JWT). Required only for legacy handoff.
# Must match the delegate deployment's per-Site secret when used.
DELEGATE_SHARED_SECRET="dev-shared-secret"

# HMAC key that signs this site's session cookie. Generate with:
#   openssl rand -hex 32
SESSION_SECRET="dev-festival-session-secret"

# Production Delegate (default). Localhost callbacks use a browser-delivered
# signed bridge so you do not need a local Delegate process. Optional override:
# DELEGATE_URL="http://localhost:8787"
DELEGATE_URL="https://delegate.engine9.ai"
# Dev server port (default 3000; 3001 and 3002 are tried if 3000 is busy).
# Startup fails if PORT is set and that port is already in use.
# PORT=3000
